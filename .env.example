# SPAVO Digital — variáveis de ambiente
# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA commite .env.local ou valores secretos.

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SOMENTE em scripts de servidor / CI, NUNCA no frontend
# SUPABASE_SERVICE_ROLE_KEY=
